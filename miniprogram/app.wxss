/* ============================================
   小错题家 — Apple Design Language Global Styles
   Based on Apple Human Interface Guidelines
   All values hardcoded for max WeChat compatibility
   ============================================ */

/* ---------- Page Base ---------- */
page {
  background: #F2F2F7;
  color: #1C1C1E;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Helvetica Neue", "PingFang SC", sans-serif;
  font-size: 30rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  min-height: 100vh;
}

/* ---------- Page Container ---------- */
.page {
  padding: 0 32rpx 120rpx;
  box-sizing: border-box;
}

/* ---------- Large Title (iOS Style) ---------- */
.large-title {
  display: block;
  font-size: 68rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  color: #1C1C1E;
  margin: 0;
  line-height: 1.1;
}

.large-title-subtitle {
  display: block;
  font-size: 30rpx;
  color: #8E8E93;
  margin-top: 12rpx;
  line-height: 1.4;
}

/* ---------- Eyebrow (Section Label) ---------- */
.eyebrow {
  display: block;
  font-size: 23rpx;
  color: #8E8E93;
  letter-spacing: 1rpx;
  text-transform: uppercase;
  margin-bottom: 8rpx;
}

/* ---------- Section Header ---------- */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 0 8rpx;
  margin: 48rpx 0 20rpx;
}

.section-header__title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1C1C1E;
  letter-spacing: -0.5rpx;
}

.section-header__action {
  font-size: 30rpx;
  color: #007AFF;
  font-weight: 500;
}

/* ---------- Card (iOS Inset Grouped Style) ---------- */
.card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx;
  margin-top: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

/* ---------- Grouped List Card (iOS Settings Style) ---------- */
.group-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
  margin-top: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.group-card__header {
  padding: 0 36rpx 16rpx;
  font-size: 26rpx;
  color: #8E8E93;
  font-weight: 400;
  margin-top: 28rpx;
}

.group-card__footer {
  padding: 12rpx 36rpx 20rpx;
  font-size: 24rpx;
  color: #8E8E93;
  line-height: 1.4;
}

.group-row {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  padding: 0 36rpx;
  position: relative;
}

.group-row::after {
  content: '';
  position: absolute;
  left: 36rpx;
  right: 0;
  bottom: 0;
  height: 1rpx;
  background: #E5E5EA;
}

.group-row:last-child::after {
  display: none;
}

.group-row__label {
  flex-shrink: 0;
  font-size: 32rpx;
  color: #1C1C1E;
  font-weight: 400;
  width: 160rpx;
}

.group-row__value {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  color: #8E8E93;
}

.group-row__input {
  flex: 1;
  text-align: right;
  font-size: 32rpx;
  color: #1C1C1E;
}

/* ---------- Buttons ---------- */
button {
  font-size: 32rpx;
  border-radius: 28rpx;
  margin: 0;
}

button::after {
  border: 0;
}

.btn-primary {
  background: #007AFF;
  color: #FFFFFF;
  border-radius: 28rpx;
  font-size: 34rpx;
  font-weight: 600;
  height: 100rpx;
  line-height: 100rpx;
  margin-top: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 122, 255, 0.25);
}

.btn-primary[disabled] {
  opacity: 0.4;
  box-shadow: none;
}

.btn-secondary {
  background: rgba(120, 128, 128, 0.12);
  color: #007AFF;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 500;
}

.btn-plain {
  background: transparent;
  color: #007AFF;
  font-size: 30rpx;
  font-weight: 500;
}

/* ---------- Pill / Tag ---------- */
.pill {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: 100rpx;
  background: rgba(120, 128, 128, 0.12);
  font-size: 24rpx;
  font-weight: 500;
  color: #8E8E93;
  margin-right: 12rpx;
}

.pill--blue {
  background: rgba(0, 122, 255, 0.1);
  color: #007AFF;
}

.pill--green {
  background: rgba(52, 199, 89, 0.1);
  color: #34C759;
  margin-right: 8rpx;
}

.pill--orange {
  background: rgba(255, 149, 0, 0.1);
  color: #FF9500;
}

.pill--purple {
  background: rgba(175, 82, 222, 0.1);
  color: #AF52DE;
}

.pill--red {
  background: rgba(255, 59, 48, 0.1);
  color: #FF3B30;
}

/* ---------- Text Helpers ---------- */
.text-primary { color: #007AFF; }
.text-secondary { color: #8E8E93; }
.text-tertiary { color: #C7C7CC; }
.text-green { color: #34C759; }
.text-red { color: #FF3B30; }
.text-orange { color: #FF9500; }

.text-bold { font-weight: 600; }
.text-semibold { font-weight: 500; }
.text-tiny { font-size: 24rpx; }
.text-small { font-size: 26rpx; }
.text-base { font-size: 30rpx; }
.text-large { font-size: 36rpx; }
.text-xl { font-size: 44rpx; }

/* ---------- Row / Flex Helpers ---------- */
.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.row-center {
  display: flex;
  align-items: center;
}

/* ---------- Empty State (iOS Style) ---------- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-state__icon {
  font-size: 80rpx;
  margin-bottom: 28rpx;
  opacity: 0.3;
}

.empty-state__title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1C1C1E;
  margin-bottom: 12rpx;
}

.empty-state__subtitle {
  font-size: 28rpx;
  color: #8E8E93;
  line-height: 1.5;
  max-width: 480rpx;
}

/* ---------- Loading State ---------- */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  color: #8E8E93;
  font-size: 30rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 6rpx solid #E5E5EA;
  border-top-color: #007AFF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ---------- Inputs ---------- */
input, textarea {
  font-size: 32rpx;
  color: #1C1C1E;
  line-height: 1.5;
}

input::placeholder, textarea::placeholder {
  color: #C7C7CC;
}

textarea {
  width: 100%;
  box-sizing: border-box;
  line-height: 1.6;
}

/* ---------- Separators ---------- */
.separator {
  height: 1rpx;
  background: #E5E5EA;
  margin: 0 36rpx;
}

/* ---------- Safe Area Bottom ---------- */
.safe-area-bottom {
  height: env(safe-area-inset-bottom);
}
