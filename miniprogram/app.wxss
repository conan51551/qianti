page{background:#f4f7f3;color:#263d32;font-family:-apple-system,BlinkMacSystemFont,sans-serif} .page{padding:40rpx 32rpx 56rpx;box-sizing:border-box} .eyebrow{font-size:23rpx;color:#788c7e;letter-spacing:3rpx}.title{display:block;font-size:48rpx;font-weight:700;margin:12rpx 0}.subtitle{font-size:26rpx;color:#859389;line-height:1.7}.card{background:#fff;border-radius:28rpx;padding:30rpx;margin-top:24rpx;box-shadow:0 8rpx 30rpx rgba(45,75,51,.03)}button{font-size:28rpx;border-radius:20rpx}button::after{border:0}.primary{background:#23805e;color:#fff;margin-top:32rpx}.label{display:block;font-size:26rpx;font-weight:600;margin-bottom:18rpx}input,textarea{font-size:29rpx;line-height:1.7}textarea{width:100%;box-sizing:border-box}.muted{color:#8a978e;font-size:25rpx}.row{display:flex;justify-content:space-between;align-items:center}.pill{background:#edf5ed;color:#398364;border-radius:12rpx;padding:8rpx 16rpx;font-size:23rpx}
