<view class="page"><view class="field"><text>年级</text><input placeholder="如：三年级" value="{{form.grade}}" data-key="grade" bindinput="onInput" /></view><view class="field"><text>学科</text><input placeholder="如：数学" value="{{form.subject}}" data-key="subject" bindinput="onInput" /></view><button bindtap="chooseImage">{{imageFileId ? '已上传题目图片' : '上传题目图片（可选）'}}</button><view class="field block"><text>题目</text><textarea placeholder="请输入错题内容" value="{{form.questionText}}" data-key="questionText" bindinput="onInput" /></view><view class="field block"><text>我的答案（可选）</text><textarea value="{{form.userAnswer}}" data-key="userAnswer" bindinput="onInput" /></view><view class="field block"><text>正确答案（可选）</text><textarea value="{{form.correctAnswer}}" data-key="correctAnswer" bindinput="onInput" /></view><button type="primary" bindtap="save" loading="{{saving}}">保存错题</button></view>
