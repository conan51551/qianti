/* ============================================
   录入页 — Apple Design Language
   ============================================ */

.nav-area {
  padding: 20rpx 8rpx 0;
}

/* Photo Picker Area */
.photo-area {
  width: 100%;
  height: 420rpx;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  margin-top: 28rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-sm);
}

.photo-area__image {
  width: 100%;
  height: 100%;
}

.photo-area__placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.photo-area__icon-wrapper {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(0, 122, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.photo-area__icon {
  font-size: 52rpx;
  color: var(--color-primary);
}

.photo-area__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-label);
}

.photo-area__hint {
  font-size: 26rpx;
  color: var(--color-label-secondary);
}

.photo-area__tip {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-label-tertiary);
  margin-top: 20rpx;
}

/* Group Row Textarea Override */
.group-row--textarea {
  padding: 32rpx 36rpx;
  min-height: auto;
  flex-direction: column;
  align-items: stretch;
}

.group-row--textarea::after {
  display: none;
}

.group-row__textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: var(--color-label);
  text-align: left;
}
