/* ============================================
   录入页 — Apple Design Language
   ============================================ */

.nav-area {
  padding: 20rpx 8rpx 0;
}

/* Photo Picker Area */
.photo-area {
  width: 100%;
  height: 420rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  margin-top: 28rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.photo-area__placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.photo-area__icon-wrapper {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(0, 122, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.photo-area__icon {
  font-size: 52rpx;
  color: #007AFF;
}

.photo-area__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1C1C1E;
  margin-top: 12rpx;
}

.photo-area__hint {
  font-size: 26rpx;
  color: #8E8E93;
  margin-top: 8rpx;
}

/* Photo Preview with Actions */
.photo-preview {
  margin-top: 28rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.photo-preview__image {
  width: 100%;
  height: 420rpx;
  background: #F2F2F7;
}

.photo-preview__actions {
  display: flex;
  border-top: 1rpx solid #E5E5EA;
}

.photo-preview__btn {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  padding: 28rpx 0;
  position: relative;
}

.photo-preview__btn::after {
  content: '';
  position: absolute;
  right: 0;
  top: 25%;
  bottom: 25%;
  width: 1rpx;
  background: #E5E5EA;
}

.photo-preview__btn:last-child::after {
  display: none;
}

.photo-preview__btn--change {
  color: #007AFF;
}

.photo-preview__btn--remove {
  color: #FF3B30;
}

/* Group Row Textarea Override */
.group-row--textarea {
  padding: 32rpx 36rpx;
  min-height: auto;
  flex-direction: column;
  align-items: stretch;
}

.group-row--textarea::after {
  display: none;
}

.group-row__textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: #1C1C1E;
  text-align: left;
}

/* Picker Row Arrow */
.group-row__arrow {
  font-size: 36rpx;
  color: #C7C7CC;
  font-weight: 300;
  margin-left: 8rpx;
}
