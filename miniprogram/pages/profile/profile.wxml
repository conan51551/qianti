<view class="page">
  <!-- Profile Header Card -->
  <view class="profile-hero">
    <view class="profile-hero__avatar">
      <text class="profile-hero__avatar-text">{{form.name ? form.name[0] : '我'}}</text>
    </view>
    <text class="profile-hero__name">{{form.name || '小小学习家'}}</text>
    <text class="profile-hero__slogan">每天进步一点点</text>
  </view>

  <!-- Login Button (if not logged in) -->
  <button 
    wx:if="{{!loggedIn}}" 
    class="btn-primary" 
    bindtap="login" 
    loading="{{loading}}"
  >
    微信登录
  </button>

  <!-- Profile Info Card -->
  <view wx:if="{{loggedIn}}">
    <view class="section-header">
      <text class="section-header__title">个人信息</text>
    </view>

    <view class="group-card">
      <view class="group-row">
        <text class="group-row__label">名称</text>
        <input class="group-row__input" type="nickname" placeholder="怎么称呼你？" value="{{form.name}}" data-key="name" bindinput="onInput" maxlength="20"/>
      </view>
      <view class="separator"></view>
      <view class="group-row">
        <text class="group-row__label">年龄</text>
        <input class="group-row__input" type="number" placeholder="请输入年龄" value="{{form.age}}" data-key="age" bindinput="onInput" maxlength="2"/>
      </view>
      <view class="separator"></view>
      <picker mode="selector" range="{{gradeOptions}}" value="{{gradeIndex}}" bindchange="onGradeChange">
        <view class="group-row">
          <text class="group-row__label">年级</text>
          <text class="group-row__value">{{gradeOptions[gradeIndex] || '请选择'}}</text>
          <text class="group-row__arrow">›</text>
        </view>
      </picker>
    </view>
  </view>

  <!-- Data Management -->
  <view wx:if="{{loggedIn}}">
    <view class="section-header">
      <text class="section-header__title">数据管理</text>
    </view>

    <view class="group-card">
      <view class="group-row" bindtap="exportMistakes">
        <text class="group-row__label">导出错题</text>
        <text class="group-row__value">JSON 格式 ›</text>
      </view>
      <view class="separator"></view>
      <view class="group-row" bindtap="showPrivacy">
        <text class="group-row__label">隐私说明</text>
        <text class="group-row__value">›</text>
      </view>
      <view class="separator"></view>
      <view class="group-row group-row--danger" bindtap="clearAllData">
        <text class="group-row__label text-red">清空所有错题</text>
        <text class="group-row__value text-red">›</text>
      </view>
    </view>
  </view>

  <!-- About Section -->
  <view wx:if="{{loggedIn}}">
    <view class="section-header">
      <text class="section-header__title">关于</text>
    </view>

    <view class="group-card">
      <view class="group-row" bindtap="showAbout">
        <text class="group-row__label">应用版本</text>
        <text class="group-row__value">1.0.0</text>
      </view>
      <view class="separator"></view>
      <view class="group-row" bindtap="showAbout">
        <text class="group-row__label">数据存储</text>
        <text class="group-row__value">微信云服务 ›</text>
      </view>
    </view>
  </view>

  <!-- Save Button -->
  <button 
    wx:if="{{loggedIn}}" 
    class="btn-primary" 
    loading="{{saving}}" 
    disabled="{{saving}}" 
    bindtap="save"
  >
    保存个人信息
  </button>

  <!-- Footer Note -->
  <text class="profile-footer">登录后，个人信息同步保存到微信云服务</text>
  <view class="safe-area-bottom"></view>
</view>
