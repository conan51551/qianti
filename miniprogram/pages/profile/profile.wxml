<view class="page"><text class="eyebrow">属于你的成长档案</text><text class="title">我的</text><view class="profile-head"><view class="avatar">{{form.name ? form.name[0] : '我'}}</view><text class="name">{{form.name || '小小学习家'}}</text><text class="subtitle">每天进步一点点</text></view><button wx:if="{{!loggedIn}}" class="primary" bindtap="login" loading="{{loading}}">微信登录</button><view wx:if="{{loggedIn}}" class="card"><text class="label">个人信息</text><view class="profile-row"><text>名称</text><input type="nickname" placeholder="怎么称呼你？" value="{{form.name}}" data-key="name" bindinput="onInput" maxlength="20"/></view><view class="profile-row"><text>年龄</text><input placeholder="请输入年龄" type="number" value="{{form.age}}" data-key="age" bindinput="onInput" maxlength="2"/></view><view class="profile-row"><text>年级</text><input placeholder="如：三年级" value="{{form.grade}}" data-key="grade" bindinput="onInput" maxlength="20"/></view></view><button wx:if="{{loggedIn}}" class="primary" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存个人信息</button><text class="note">登录后，个人信息同步保存到微信云服务</text></view>
