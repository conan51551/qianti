/* ============================================
   我的页 — Apple Design Language
   ============================================ */

.page {
  padding-top: 40rpx;
}

/* Profile Hero Section */
.profile-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 32rpx;
}

.profile-hero__avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #007AFF, #5AC8FA);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 122, 255, 0.2);
}

.profile-hero__avatar-text {
  font-size: 64rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.profile-hero__name {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-label);
  margin-top: 24rpx;
}

.profile-hero__slogan {
  font-size: 28rpx;
  color: var(--color-label-secondary);
  margin-top: 8rpx;
}

/* Footer Note */
.profile-footer {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: var(--color-label-tertiary);
  margin-top: 32rpx;
  padding-bottom: 40rpx;
}
