/* ============================================
   我的页 — Apple Design Language
   ============================================ */

.page {
  padding-top: 40rpx;
}

/* Profile Hero Section */
.profile-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 32rpx;
}

.profile-hero__avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #007AFF, #5AC8FA);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 122, 255, 0.2);
}

.profile-hero__avatar-text {
  font-size: 64rpx;
  font-weight: 700;
  color: #FFFFFF;
}

.profile-hero__name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1C1C1E;
  margin-top: 24rpx;
}

.profile-hero__slogan {
  font-size: 28rpx;
  color: #8E8E93;
  margin-top: 8rpx;
}

/* Membership Card */
.membership-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, rgba(0, 122, 255, 0.08), rgba(90, 200, 250, 0.06));
  border-radius: 24rpx;
  padding: 32rpx 36rpx;
  margin-top: 20rpx;
  border: 2rpx solid rgba(0, 122, 255, 0.15);
}

.membership-card__left {
  display: flex;
  flex-direction: column;
}

.membership-card__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #007AFF;
}

.membership-card__desc {
  font-size: 26rpx;
  color: #8E8E93;
  margin-top: 6rpx;
}

.membership-card__btn {
  font-size: 30rpx;
  font-weight: 600;
  color: #007AFF;
  padding: 12rpx 28rpx;
  background: rgba(0, 122, 255, 0.1);
  border-radius: 100rpx;
}

/* Group Row Arrow */
.group-row__arrow {
  font-size: 36rpx;
  color: #C7C7CC;
  font-weight: 300;
  margin-left: 8rpx;
}

.group-row--danger {
  min-height: 112rpx;
}

/* Footer Note */
.profile-footer {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #C7C7CC;
  margin-top: 32rpx;
  padding-bottom: 20rpx;
}
