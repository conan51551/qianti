.profile-head{display:flex;flex-direction:column;align-items:center;padding:32rpx 0}.avatar{width:132rpx;height:132rpx;border-radius:50%;background:#e0edde;color:#23805e;display:flex;align-items:center;justify-content:center;font-size:52rpx}.name{font-size:36rpx;font-weight:600;margin:20rpx 0 8rpx}.profile-row{display:flex;align-items:center;padding:28rpx 0;border-bottom:1rpx solid #eff2ed;font-size:28rpx}.profile-row:last-child{border-bottom:0}.profile-row input{flex:1;text-align:right;margin-left:40rpx}.note{display:block;text-align:center;color:#99a499;font-size:23rpx;margin-top:24rpx}
