/* ============================================
   首页 — Apple Design Language
   ============================================ */

/* Navigation Area */
.nav-area {
  padding: 20rpx 8rpx 0;
}

/* Summary Card */
.summary-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: 40rpx 36rpx;
  margin-top: 28rpx;
  box-shadow: var(--shadow-sm);
}

.summary-card__left {
  display: flex;
  flex-direction: column;
}

.summary-card__count {
  font-size: 80rpx;
  font-weight: 800;
  color: var(--color-label);
  line-height: 1;
  letter-spacing: -2rpx;
}

.summary-card__label {
  font-size: 26rpx;
  color: var(--color-label-secondary);
  margin-top: 8rpx;
}

.summary-card__action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.summary-card__btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 122, 255, 0.3);
}

.summary-card__btn-icon {
  font-size: 44rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}

.summary-card__btn-text {
  font-size: 24rpx;
  color: var(--color-label-secondary);
}

/* Segmented Control */
.segmented {
  white-space: nowrap;
  margin: 28rpx 0 8rpx;
  display: flex;
  gap: 12rpx;
}

.segmented__item {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 36rpx;
  border-radius: 100rpx;
  background: var(--color-fill-secondary);
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-label-secondary);
  transition: all 0.2s ease;
}

.segmented__item--active {
  background: var(--color-primary);
  color: #FFFFFF;
}

/* Mistake Card */
.mistake-card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-top: 20rpx;
  box-shadow: var(--shadow-sm);
}

.mistake-card__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 36rpx 0;
}

.mistake-card__tags {
  display: flex;
  gap: 12rpx;
}

.mistake-card__time {
  font-size: 24rpx;
  color: var(--color-label-tertiary);
}

.mistake-card__thumb {
  width: 100%;
  height: 320rpx;
  border-radius: var(--radius-md);
  margin: 24rpx 36rpx 0;
  width: calc(100% - 72rpx);
  object-fit: cover;
}

.mistake-card__question {
  display: block;
  font-size: 32rpx;
  line-height: 1.6;
  color: var(--color-label);
  padding: 24rpx 36rpx 0;
}

/* Analysis Status */
.mistake-card__status {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 36rpx 0;
}

/* AI Analysis Box */
.mistake-card__analysis {
  background: rgba(0, 122, 255, 0.04);
  border-radius: var(--radius-md);
  padding: 24rpx 28rpx;
  margin: 24rpx 36rpx 0;
  border-left: 6rpx solid var(--color-primary);
}

.mistake-card__analysis-header {
  margin-bottom: 12rpx;
}

.mistake-card__analysis-type {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.mistake-card__analysis-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--color-label);
}

.mistake-card__knowledge {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

/* Card Actions */
.mistake-card__actions {
  display: flex;
  border-top: 1rpx solid var(--color-separator);
  margin-top: 24rpx;
}

.mistake-card__action {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 28rpx 0;
  position: relative;
}

.mistake-card__action::after {
  content: '';
  position: absolute;
  right: 0;
  top: 20%;
  bottom: 20%;
  width: 1rpx;
  background: var(--color-separator);
}

.mistake-card__action:last-child::after {
  display: none;
}

.mistake-card__action-icon {
  font-size: 28rpx;
}

.mistake-card__action-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-primary);
}

.mistake-card__action--danger .mistake-card__action-text {
  color: var(--color-red);
}

.mistake-card__action--danger {
  /* No extra styling needed, handled by text color */
}
