/* ============================================
   首页 — Apple Design Language
   ============================================ */

/* Navigation Area */
.nav-area {
  padding: 20rpx 8rpx 0;
}

/* Summary Card */
.summary-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 40rpx 36rpx;
  margin-top: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.summary-card__left {
  display: flex;
  flex-direction: column;
}

.summary-card__count {
  font-size: 80rpx;
  font-weight: 800;
  color: #1C1C1E;
  line-height: 1;
  letter-spacing: -2rpx;
}

.summary-card__label {
  font-size: 26rpx;
  color: #8E8E93;
  margin-top: 8rpx;
}

.summary-card__action {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-card__btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #007AFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 122, 255, 0.3);
}

.summary-card__btn-icon {
  font-size: 44rpx;
  color: #FFFFFF;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}

.summary-card__btn-text {
  font-size: 24rpx;
  color: #8E8E93;
  margin-top: 8rpx;
}

/* Segmented Control */
.segmented {
  white-space: nowrap;
  margin: 28rpx 0 8rpx;
}

.segmented__item {
  display: inline-block;
  padding: 16rpx 36rpx;
  margin-right: 12rpx;
  border-radius: 100rpx;
  background: rgba(120, 128, 128, 0.12);
  font-size: 28rpx;
  font-weight: 500;
  color: #8E8E93;
  transition: all 0.2s ease;
}

.segmented__item--active {
  background: #007AFF;
  color: #FFFFFF;
}

/* Section Header Links */
.section-header__links {
  display: flex;
  align-items: center;
}

.section-header__action--sep {
  margin-left: 24rpx;
  position: relative;
}

.section-header__action--sep::before {
  content: '';
  position: absolute;
  left: -12rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 1rpx;
  height: 24rpx;
  background: #E5E5EA;
}

/* Mastery Quick Stats Bar */
.mastery-quick {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 28rpx 16rpx;
  margin-top: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.mastery-quick__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.mastery-quick__num {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -1rpx;
}

.mastery-quick__label {
  font-size: 22rpx;
  color: #8E8E93;
  margin-top: 8rpx;
}

.mastery-quick__divider {
  width: 1rpx;
  height: 48rpx;
  background: #E5E5EA;
}

/* Mistake Card */
.mistake-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  overflow: hidden;
  margin-top: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.mistake-card__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 36rpx 0;
}

.mistake-card__tags {
  display: flex;
  align-items: center;
}

.mistake-card__time {
  font-size: 24rpx;
  color: #C7C7CC;
}

.mistake-card__thumb-wrap {
  padding: 24rpx 36rpx 0;
}

.mistake-card__thumb {
  width: 100%;
  height: 320rpx;
  border-radius: 20rpx;
}

.mistake-card__question {
  display: block;
  font-size: 32rpx;
  line-height: 1.6;
  color: #1C1C1E;
  padding: 24rpx 36rpx 0;
}

/* Analysis Status */
.mistake-card__status {
  display: flex;
  align-items: center;
  padding: 20rpx 36rpx 0;
}

.mistake-card__status .loading-spinner {
  width: 28rpx;
  height: 28rpx;
  border-width: 3rpx;
  border-color: #E5E5EA;
  border-top-color: #007AFF;
  margin: 0 12rpx 0 0;
}

.mistake-card__status text {
  font-size: 26rpx;
  color: #8E8E93;
}

/* AI Analysis Box */
.mistake-card__analysis {
  background: rgba(0, 122, 255, 0.04);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin: 24rpx 36rpx 0;
  border-left: 6rpx solid #007AFF;
}

.mistake-card__analysis-header {
  margin-bottom: 12rpx;
}

.mistake-card__analysis-type {
  font-size: 30rpx;
  font-weight: 600;
  color: #007AFF;
}

.mistake-card__analysis-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.6;
  color: #1C1C1E;
}

.mistake-card__knowledge {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

/* Card Actions */
.mistake-card__actions {
  display: flex;
  border-top: 1rpx solid #E5E5EA;
  margin-top: 24rpx;
}

.mistake-card__action {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 0;
  position: relative;
}

.mistake-card__action::after {
  content: '';
  position: absolute;
  right: 0;
  top: 20%;
  bottom: 20%;
  width: 1rpx;
  background: #E5E5EA;
}

.mistake-card__action:last-child::after {
  display: none;
}

.mistake-card__action-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.mistake-card__action-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #007AFF;
}

.mistake-card__action--danger .mistake-card__action-text {
  color: #FF3B30;
}

/* Mastery Dots on Cards */
.mistake-card__mastery {
  display: flex;
  align-items: center;
  margin-left: 12rpx;
}

.mastery-dot-mini {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #E5E5EA;
  margin-right: 6rpx;
}

.mastery-dot-mini--active {
  background: #34C759;
}

/* Today's Review Section */
.review-scroll {
  white-space: nowrap;
  margin-top: 8rpx;
}

.review-card {
  display: inline-flex;
  flex-direction: column;
  width: 280rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-right: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  vertical-align: top;
}

.review-card__header {
  display: flex;
  margin-bottom: 16rpx;
}

.review-card__text {
  display: block;
  font-size: 28rpx;
  line-height: 1.5;
  color: #1C1C1E;
  white-space: normal;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  min-height: 84rpx;
}

.review-card__footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  border-top: 1rpx solid #F2F2F7;
  padding-top: 16rpx;
}
