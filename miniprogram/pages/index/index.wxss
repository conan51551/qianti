.summary{background:#e2eee2;border-radius:28rpx;padding:32rpx;margin-top:32rpx;display:flex;justify-content:space-between;align-items:center}.count{font-size:64rpx;font-weight:700;margin-right:14rpx}.summary-label{font-size:24rpx;color:#67836e}.summary button{margin:0;background:#fff;color:#23805e;font-size:24rpx}.section{margin:40rpx 0 0;font-weight:600}.empty{text-align:center;padding:56rpx 24rpx}.empty text{display:block}.empty-icon{font-size:70rpx;color:#93b7a1;margin-bottom:20rpx}.question{display:block;font-size:30rpx;line-height:1.7;margin:22rpx 0}.thumb{width:100%;height:260rpx;border-radius:18rpx;margin-top:24rpx}
.ai-box{background:#f0f7ee;border-radius:18rpx;padding:22rpx;margin:20rpx 0;color:#46624d;font-size:26rpx;line-height:1.7}.ai-box text{display:block}.ai-title{font-weight:600;color:#23805e;margin-bottom:8rpx}
.card-actions{display:flex;align-items:center;gap:16rpx}.delete-btn{margin:0;padding:0 14rpx;height:48rpx;line-height:48rpx;border-radius:24rpx;background:#fff1ef;color:#c65a50;font-size:22rpx}.delete-btn::after{border:0}
.subject-tabs{white-space:nowrap;margin:24rpx 0}.subject-tab{display:inline-block;padding:12rpx 24rpx;margin-right:14rpx;border-radius:30rpx;background:#f2f5f1;color:#67836e;font-size:24rpx}.subject-tab.active{background:#23805e;color:#fff}.delete-btn{width:42px;padding:0;height:44rpx;line-height:44rpx;font-size:20rpx}.gen-btn{margin:10rpx 0;padding:0 18rpx;height:52rpx;line-height:52rpx;border-radius:26rpx;background:#e7f3ea;color:#23805e;font-size:23rpx}.gen-btn::after{border:0}.outline-entry{color:#23805e;font-size:25rpx}

.card>.row{min-height:52rpx;gap:18rpx;align-items:center}.card>.row>.pill{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.card-actions{flex-shrink:0;gap:10rpx}.card-actions .muted{white-space:nowrap}.card-actions .delete-btn{flex-shrink:0}
/* Keep Vant controls aligned with the existing card rhythm. */
.summary van-button{flex-shrink:0}.card-actions van-button.delete-btn{width:42px;min-width:42px;padding:0;border-radius:14px}.card-actions van-button.delete-btn .van-button__icon{margin:0}.card-actions van-button.delete-btn .van-button__text{display:none}.card van-button.gen-btn{margin:14rpx 0 8rpx;height:36px;border-radius:18px}
