<view class="page">
  <view class="header"><text class="title">我的错题</text><button size="mini" bindtap="toAdd">+ 录入错题</button></view>
  <view wx:if="{{loading}}" class="empty">加载中...</view>
  <view wx:elif="{{!mistakes.length}}" class="empty">还没有错题，先录入一道吧</view>
  <view wx:else>
    <view wx:for="{{mistakes}}" wx:key="_id" class="item" bindtap="openDetail" data-id="{{item._id}}">
      <view class="meta"><text>{{item.subject}}</text><text>{{item.grade}}</text></view>
      <text class="question">{{item.questionText}}</text>
      <text class="date">{{item.createdAtText}}</text>
    </view>
  </view>
</view>
