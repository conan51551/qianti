<view class="page"><text class="eyebrow">学习地图</text><text class="title">{{subject==='全部'?'知识大纲':subject+'知识大纲'}}</text><text class="subtitle">来自已收录错题的知识点整理</text><view wx:if="{{loading}}" class="card empty">正在整理知识点…</view><view wx:elif="{{error}}" class="card empty"><text>暂时无法读取知识大纲</text><button bindtap="load">重新加载</button></view><view wx:elif="{{empty}}" class="card empty"><text>还没有可展示的知识点</text><text class="subtitle">完成错题分析后，知识点会自动出现在这里</text></view><view wx:for="{{groups}}" wx:key="subject" class="group"><view class="group-title"><text>{{item.subject}}</text><text class="muted">{{item.points.length}} 个知识点</text></view><view wx:for="{{item.points}}" wx:key="name" class="point card"><view class="point-head"><text class="point-name">{{item.name}}</text><text class="count">{{item.count}}题</text></view><text class="module">知识模块：{{item.module}}</text><text class="description">知识点内容：{{item.description}}</text><text wx:if="{{item.prerequisites.length}}" class="prereq">前置知识：{{item.prerequisites.join('、')}}</text></view></view></view>
