<view class="page">
  <!-- Loading -->
  <view wx:if="{{loading}}" class="loading-state">
    <view class="loading-spinner"></view>
    <text>加载中</text>
  </view>

  <block wx:elif="{{mistake}}">
    <!-- Tags & Time -->
    <view class="detail-header">
      <view class="detail-tags">
        <text class="pill pill--blue">{{mistake.subject}}</text>
        <text class="pill">{{mistake.grade}}</text>
        <text class="pill pill--{{masteryColor}}">{{masteryLabel}}</text>
      </view>
      <text class="detail-time">{{createdAtText}}</text>
    </view>

    <!-- Image -->
    <view wx:if="{{mistake.imageFileId}}" class="detail-image-wrap" bindtap="previewImage">
      <image class="detail-image" src="{{mistake.imageFileId}}" mode="widthFix" />
      <text class="detail-image-hint">点击查看大图</text>
    </view>

    <!-- Question Section -->
    <view class="section-header" style="margin-top: 40rpx;">
      <text class="section-header__title">题目</text>
    </view>
    <view class="group-card">
      <view class="detail-text-area">
        <text class="detail-text">{{mistake.questionText || '（照片错题，请查看上方图片）'}}</text>
      </view>
    </view>

    <!-- Answers Section -->
    <view class="section-header">
      <text class="section-header__title">答案</text>
    </view>
    <view class="group-card">
      <view class="group-row">
        <text class="group-row__label">我的答案</text>
        <text class="group-row__value {{mistake.userAnswer ? 'text-red' : ''}}">{{mistake.userAnswer || '未填写'}}</text>
      </view>
      <view class="separator"></view>
      <view class="group-row">
        <text class="group-row__label">正确答案</text>
        <text class="group-row__value {{mistake.correctAnswer ? 'text-green' : ''}}">{{mistake.correctAnswer || '未填写'}}</text>
      </view>
    </view>

    <!-- AI Analysis Section -->
    <view wx:if="{{mistake.analysisStatus === 'pending'}}" class="detail-analysis-loading">
      <view class="loading-spinner" style="width: 32rpx; height: 32rpx;"></view>
      <text>AI 正在分析这道错题</text>
    </view>

    <block wx:elif="{{mistake.errorType || mistake.explanation}}">
      <view class="section-header">
        <text class="section-header__title">AI 分析</text>
      </view>
      <view class="detail-analysis">
        <view class="detail-analysis__type">
          <text class="detail-analysis__type-label">错因类型</text>
          <text class="detail-analysis__type-value">{{mistake.errorType}}</text>
        </view>
        <view wx:if="{{mistake.explanation}}" class="detail-analysis__section">
          <text class="detail-analysis__section-title">讲解</text>
          <text class="detail-analysis__section-text">{{mistake.explanation}}</text>
        </view>
        <view wx:if="{{mistake.reviewAdvice}}" class="detail-analysis__section">
          <text class="detail-analysis__section-title">复习建议</text>
          <text class="detail-analysis__section-text">{{mistake.reviewAdvice}}</text>
        </view>
      </view>
    </block>

    <!-- Knowledge Points -->
    <view wx:if="{{mistake.knowledgePoints && mistake.knowledgePoints.length}}" class="section-header">
      <text class="section-header__title">知识点</text>
    </view>
    <view wx:if="{{mistake.knowledgePoints && mistake.knowledgePoints.length}}" class="detail-knowledge">
      <text class="pill pill--green" wx:for="{{mistake.knowledgePoints}}" wx:key="*this">{{item}}</text>
    </view>

    <!-- Mastery Progress -->
    <view class="section-header">
      <text class="section-header__title">掌握度</text>
    </view>
    <view class="group-card">
      <view class="mastery-row">
        <view class="mastery-dots">
          <view class="mastery-dot {{masteryLevel >= 1 ? 'mastery-dot--active' : ''}}"></view>
          <view class="mastery-dot {{masteryLevel >= 2 ? 'mastery-dot--active' : ''}}"></view>
          <view class="mastery-dot {{masteryLevel >= 3 ? 'mastery-dot--active' : ''}}"></view>
        </view>
        <text class="mastery-text">{{masteryLabel}}</text>
      </view>
      <view wx:if="{{mistake.lastPracticeAt}}" class="separator"></view>
      <view wx:if="{{mistake.lastPracticeAt}}" class="group-row">
        <text class="group-row__label">上次练习</text>
        <text class="group-row__value">{{lastPracticeText}}</text>
      </view>
      <view wx:if="{{mistake.lastPracticeCorrect !== undefined}}" class="separator"></view>
      <view wx:if="{{mistake.lastPracticeCorrect !== undefined}}" class="group-row">
        <text class="group-row__label">练习结果</text>
        <text class="group-row__value {{mistake.lastPracticeCorrect ? 'text-green' : 'text-red'}}">{{mistake.lastPracticeCorrect ? '答对' : '答错'}}</text>
      </view>
    </view>

    <!-- Action Buttons -->
    <button class="btn-primary" bindtap="goPractice">
      开始练习
    </button>
    <button class="btn-danger" bindtap="deleteMistake">
      删除错题
    </button>
  </block>

  <!-- Error State -->
  <view wx:elif="{{error}}" class="empty-state">
    <text class="empty-state__icon">⚠︎</text>
    <text class="empty-state__title">无法加载错题详情</text>
    <button class="btn-primary" style="width: 400rpx; margin-top: 32rpx;" bindtap="loadDetail">重新加载</button>
  </view>
</view>
